# Salin jadi .env (jangan di-commit). Dipakai worker/run.sh di VPS atau saat tes lokal.
RAPIDAPI_KEY=
# Sesuaikan dengan API yang kamu subscribe (lihat tab Endpoints / Code Snippets di RapidAPI)
RAPIDAPI_HOST=instagram-scraper-api2.p.rapidapi.com
RAPIDAPI_PATH=/v1.2/posts
RAPIDAPI_PARAM=username_or_id_or_url
# Batas akun per run (0 = semua). Akun dipilih bergilir supaya kuota gratis cukup.
RAPIDAPI_MAX_CALLS=0
# Isi sama dengan jarak antar run bot (jam), supaya rotasi akun jalan benar
ROTATE_EVERY_HOURS=24

# Sandi masuk web. Isi di Vercel (Settings > Environment Variables), bukan di GitHub.
# Di produksi, web menolak semua akses kalau ini kosong. Mengganti sandi mengeluarkan semua orang.
SITE_PASSWORD=
# Opsional, tampil di footer: kontak untuk minta hapus postingan
NEXT_PUBLIC_CONTACT=
